<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FinalProject.DataEntryPage"
    Title="Enter Zodiac Info">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <Label Text="Enter Your Zodiac Info" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" />
            <Frame x:Name="formCard">
                <VerticalStackLayout Spacing="15">
                    <Entry x:Name="nameEntry" Placeholder="Name" />

                    <DatePicker x:Name="birthDatePicker" />

                    <TimePicker
    x:Name="birthTimePicker"
    TextColor="White"
    BackgroundColor="#2B2C4F" />

                    <Picker x:Name="zodiacPicker" Title="Choose Zodiac Sign">
                        <Picker.Items>
                            <x:String>Aries</x:String>
                            <x:String>Taurus</x:String>
                            <x:String>Gemini</x:String>
                            <x:String>Cancer</x:String>
                            <x:String>Leo</x:String>
                            <x:String>Virgo</x:String>
                            <x:String>Libra</x:String>
                            <x:String>Scorpio</x:String>
                            <x:String>Sagittarius</x:String>
                            <x:String>Capricorn</x:String>
                            <x:String>Aquarius</x:String>
                            <x:String>Pisces</x:String>
                        </Picker.Items>
                    </Picker>
                    <Button Text="Save To Google Sheets" Clicked="OnSaveClicked" />
                </VerticalStackLayout>
            </Frame>
            <Button Text="View Saved Readings" Clicked="OnViewClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
